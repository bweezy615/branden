DATABASE_URL=postgres://pullbell:pullbell@localhost:5432/pullbell
# Web Push (VAPID) key pair: npx web-push generate-vapid-keys
# The public key must equal NEXT_PUBLIC_VAPID_PUBLIC_KEY in apps/web.
VAPID_SUBJECT=mailto:alerts@pullbell.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Only needed if "enhanced push security" is enabled for the Expo project
EXPO_ACCESS_TOKEN=
CHECK_INTERVAL_SECONDS=60
